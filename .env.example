# Offline dsa-demo needs NONE of these settings. Copy only for the optional full app.
# Replace both CHANGE_ME placeholders with different locally chosen passwords.
DATABASE_URL=postgresql+psycopg://dsa_app:CHANGE_ME@127.0.0.1:55432/marketing_analytics
DATABASE_URL_RO=postgresql+psycopg://dsa_ro:CHANGE_ME@127.0.0.1:55432/marketing_analytics
DSA_LLM_MODE=mock
DEEPSEEK_API_KEY=
# Optional: choose an existing registered model explicitly.
DSA_DEFAULT_MODEL_KEY=
# DSA_WORKSPACE_ROOT, DSA_ENV_FILE and DSA_ARTIFACTS_DIR accept absolute local paths.
# Do not commit your .env or paste real connection strings in issues.
